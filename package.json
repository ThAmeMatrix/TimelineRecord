{
  "name": "timeline-record",
  "version": "0.2.0",
  "private": true,
  "description": "把动画、漫画、小说、电影、电视剧与日常事件铺在同一条时间轴上的记录工具（纯前端，数据保存在浏览器并可导出为 JSON）",
  "author": "ThAmeMatrix",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/suggestion": "^2.27.3",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.66.0",
    "markdown-it": "^14.3.3",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiptap-markdown": "^0.8.10",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "build": {
    "appId": "com.thame.timelinerecord",
    "productName": "TimelineRecord",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "TimelineRecord-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
